      "default": "./src/components/*.mjs"
    },
    "./blocks": {
      "types": "./src/blocks/index.d.mts",
      "default": "./src/blocks/index.mjs"
    },
    "./blocks/*": {
      "types": "./src/blocks/*.d.mts",
      "default": "./src/blocks/*.mjs"
    },
    "./icons": {
      "types": "./src/icons/index.d.mts",
      "default": "./src/icons/index.mjs"
    },
    "./icons/*": {
      "types": "./src/icons/*.d.mts",
      "default": "./src/icons/*.mjs"
    },
    "./runtime": {
      "types": "./src/runtime.d.mts",
      "default": "./src/runtime.mjs"
    },
    "./css/components.css": "./src/styles/components.css",
    "./css/blocks.css": "./src/styles/blocks.css",
    "./css/base.css": "./src/styles/base.css",
    "./css/tokens.css": "./src/styles/tokens.css",
    "./css/fonts.css": "./src/styles/fonts.css",
    "./css/*": "./src/styles/*.css",
    "./css/components/*": "./src/styles/components/*.css",
    "./css/blocks/*": "./src/styles/blocks/*.css",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "check": "node tools/build-legacy-bridge.mjs --check && node tools/build-legacy-css.mjs --check && node tools/check-syntax.cjs",
    "build": "node tools/build-legacy-bridge.mjs && node tools/build-legacy-css.mjs",
    "test": "node --test tests/api.test.mjs tests/css.test.mjs tests/consumer.test.mjs tests/package.test.mjs tests/xss.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:a11y": "node tests/a11y.cjs",
    "test:keyboard": "node tests/keyboard.cjs",
    "test:functional": "node tests/functional.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "tag": "alpha"
  },
  "license": "MIT",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32"
