{
  "name": "sesama-ui",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "A shared UI language for dashboards, AI workspaces, and everyday tools. Pure ESM builders, scoped CSS, zero dependencies.",
  "keywords": [
    "design-system",
    "ui",
    "components",
    "html",
    "esm",
    "vanilla-js",
    "no-framework"
  ],
  "type": "module",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.mts",
  "repository": {
    "type": "git",
    "url": "https://github.com/joyedz/sesamaui.git"
  },
  "homepage": "https://github.com/joyedz/sesamaui#readme",
  "bugs": {
    "url": "https://github.com/joyedz/sesamaui/issues"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./button": {
      "types": "./src/components/button.d.mts",
      "default": "./src/components/button.mjs"
    },
